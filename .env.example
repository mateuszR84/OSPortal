# Skopiuj do .env i uzupełnij. .env NIE jest commitowany (patrz .gitignore).

# Adres, na który trafiają zgłoszenia z formularzy.
MAIL_TO=mateusz@studiodevs.pl

# Nadawca widoczny w mailu (nie musi istnieć jako realna skrzynka, ale
# w produkcji lepiej żeby domena zgadzała się z SPF/DKIM serwera SMTP).
MAIL_FROM=formularz@osportal.pl
MAIL_FROM_NAME=OSPortal

# Lokalnie: Mailpit, bez auth i szyfrowania.
# Produkcyjnie (RunCloud): dane SMTP realnej skrzynki/relaya.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
